# ==== PracticIA · Frontend (Netlify / local) ====
# Copia este archivo a `.env` y completa. En Netlify: Site settings → Environment variables.
# Estas variables VITE_* quedan visibles en el navegador: solo pon aquí claves PÚBLICAS.
# ⚠️ NO pongas claves de Gemini, Groq ni OpenRouter aquí: viven solo en el backend.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon / publishable" de Supabase (Project Settings → API). NUNCA la service_role.
VITE_SUPABASE_ANON_KEY=

# URL del backend en Render (sin barra final)
VITE_BACKEND_URL=https://backend-agent-yipe.onrender.com
