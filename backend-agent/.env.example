# ==== PracticIA · Backend (Render) ====
# En Render: Environment → Add Environment Variable. Estas claves son SECRETAS.
PORT=5000

# Dominio(s) del frontend permitidos por CORS (separados por coma)
FRONTEND_URL=https://practicia-app.netlify.app

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- IA en cascada: Gemini → Groq → OpenRouter (basta con que haya una) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Modelos (opcional). Se prueban en orden; cámbialos aquí cuando alguno se retire ---
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3-flash-preview
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_MODELS=openai/gpt-oss-120b:free,openai/gpt-oss-20b:free
